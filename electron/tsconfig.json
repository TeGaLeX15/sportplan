{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "outDir": "../out-electron",
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"]
  },
  "include": ["./**/*.ts"]
}
